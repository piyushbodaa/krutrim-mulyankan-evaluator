{
  "$defs": {
    "JobEvent": {
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "runner_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runner Id"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "grade_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grade Status"
        },
        "passed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        }
      },
      "required": [
        "at",
        "stage"
      ],
      "title": "JobEvent",
      "type": "object"
    },
    "JobRequest": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Api Version",
          "type": "string"
        },
        "suite": {
          "default": "india-pilot",
          "enum": [
            "india-pilot",
            "railway-pilot"
          ],
          "title": "Suite",
          "type": "string"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "minItems": 1,
          "title": "Task Ids",
          "type": "array"
        },
        "adapter_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Adapter Ids",
          "type": "array"
        },
        "seed": {
          "default": 12,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9_-]{8,100}$",
          "title": "Idempotency Key",
          "type": "string"
        }
      },
      "required": [
        "task_ids",
        "adapter_ids",
        "idempotency_key"
      ],
      "title": "JobRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Api Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/JobRequest"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "cancelling",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "parent_job_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Job Id"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "processed": {
      "default": 0,
      "title": "Processed",
      "type": "integer"
    },
    "execution_errors": {
      "default": 0,
      "title": "Execution Errors",
      "type": "integer"
    },
    "grader_errors": {
      "default": 0,
      "title": "Grader Errors",
      "type": "integer"
    },
    "pending": {
      "default": 0,
      "title": "Pending",
      "type": "integer"
    },
    "graded": {
      "default": 0,
      "title": "Graded",
      "type": "integer"
    },
    "passed": {
      "default": 0,
      "title": "Passed",
      "type": "integer"
    },
    "skipped": {
      "default": 0,
      "title": "Skipped",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/JobEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "result_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Url"
    },
    "private_result_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Private Result Url"
    }
  },
  "required": [
    "id",
    "request",
    "status",
    "created_at",
    "updated_at",
    "total"
  ],
  "title": "JobState",
  "type": "object"
}
