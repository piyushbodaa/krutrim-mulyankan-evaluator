{
  "$defs": {
    "AppContext": {
      "additionalProperties": false,
      "properties": {
        "app": {
          "maxLength": 100,
          "minLength": 1,
          "title": "App",
          "type": "string"
        },
        "app_url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Url"
        },
        "client": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Client",
          "type": "string"
        },
        "plan": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Plan",
          "type": "string"
        },
        "client_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Version"
        },
        "displayed_model": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayed Model"
        },
        "session": {
          "default": "unknown",
          "enum": [
            "fresh",
            "existing",
            "unknown"
          ],
          "title": "Session",
          "type": "string"
        },
        "context_notes": {
          "default": "",
          "maxLength": 4000,
          "title": "Context Notes",
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "observed_latency_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Latency S"
        },
        "subscription_amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Amount"
        },
        "subscription_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Currency"
        },
        "subscription_period": {
          "anyOf": [
            {
              "enum": [
                "month",
                "year",
                "other"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Period"
        },
        "subscription_price_source": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subscription Price Source"
        },
        "observation_kind": {
          "default": "contributor_reported",
          "enum": [
            "contributor_reported",
            "test_fixture"
          ],
          "title": "Observation Kind",
          "type": "string"
        }
      },
      "required": [
        "app",
        "client",
        "plan"
      ],
      "title": "AppContext",
      "type": "object"
    },
    "ComparisonEntry": {
      "additionalProperties": false,
      "properties": {
        "configuration": {
          "$ref": "#/$defs/NamedConfiguration"
        },
        "answer": {
          "$ref": "#/$defs/RecordedAnswer"
        }
      },
      "required": [
        "configuration",
        "answer"
      ],
      "title": "ComparisonEntry",
      "type": "object"
    },
    "NamedConfiguration": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9._-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "app_context": {
          "$ref": "#/$defs/AppContext"
        },
        "origin": {
          "default": "user_created",
          "enum": [
            "template",
            "user_created",
            "imported"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "app_context"
      ],
      "title": "NamedConfiguration",
      "type": "object"
    },
    "RecordedAnswer": {
      "additionalProperties": false,
      "properties": {
        "response": {
          "maxLength": 30000,
          "title": "Response",
          "type": "string"
        },
        "evidence_note": {
          "maxLength": 4000,
          "minLength": 8,
          "title": "Evidence Note",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Evidence References",
          "type": "array"
        },
        "completion_status": {
          "default": "unknown",
          "enum": [
            "completed",
            "partial",
            "not_completed",
            "unknown"
          ],
          "title": "Completion Status",
          "type": "string"
        },
        "elapsed_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed S"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "cost_amount": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Amount"
        },
        "cost_currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Currency"
        },
        "cost_source": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Source"
        },
        "kind": {
          "default": "contributor_reported",
          "enum": [
            "contributor_reported",
            "test_fixture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "exact_prompt_used": {
          "default": false,
          "title": "Exact Prompt Used",
          "type": "boolean"
        },
        "attested": {
          "default": false,
          "title": "Attested",
          "type": "boolean"
        }
      },
      "required": [
        "response",
        "evidence_note"
      ],
      "title": "RecordedAnswer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "kind": {
      "const": "manual_comparison",
      "default": "manual_comparison",
      "title": "Kind",
      "type": "string"
    },
    "suite": {
      "const": "india-pilot",
      "default": "india-pilot",
      "title": "Suite",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_version": {
      "minimum": 1,
      "title": "Task Version",
      "type": "integer"
    },
    "task_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Task Sha256",
      "type": "string"
    },
    "prompt_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Prompt Sha256",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/ComparisonEntry"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Entries",
      "type": "array"
    },
    "recorded_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recorded Run Id"
    }
  },
  "required": [
    "task_id",
    "task_version",
    "task_sha256",
    "prompt_sha256",
    "entries"
  ],
  "title": "ComparisonBundle",
  "type": "object"
}
