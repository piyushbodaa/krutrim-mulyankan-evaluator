{
  "cleanUrls": true,
  "rewrites": [
    {"source": "/favicon.ico", "destination": "/brand/favicon.ico"},
    {"source": "/apple-touch-icon.png", "destination": "/brand/favicon-180.png"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; form-action 'none'; base-uri 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex"}
      ]
    }
  ]
}
