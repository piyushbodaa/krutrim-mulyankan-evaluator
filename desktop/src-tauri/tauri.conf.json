{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krutrim Mulyankan",
  "version": "0.4.1",
  "identifier": "in.krutrimmulyankan.evaluator",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:17321",
    "beforeDevCommand": "python3 -m http.server 17321 --directory ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Krutrim Mulyankan",
        "width": 1120,
        "height": 820,
        "minWidth": 880,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; frame-src http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Check AI models on your own computer",
    "longDescription": "Krutrim Mulyankan runs small AI checks on your own computer and shows plain charts. Unvalidated pilot. Not a ranking.",
    "resources": {
      "resources/engine/": "engine/"
    },
    "macOS": {
      "exceptionDomain": "127.0.0.1",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1MjQxRDkzMjBDNUMxNDIKUldSQ3djVWdreDBreFJGRGZia3JIZ3JDTGtPZkZPZSt6c1VBd2w3SzBYQjBZVldGQnFFRWVBbDQK",
      "endpoints": [
        "https://github.com/piyushbodaa/krutrim-mulyankan-evaluator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
